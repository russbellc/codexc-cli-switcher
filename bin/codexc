#!/usr/bin/env python3
"""
codexc - Gestor multi-cuenta, aislamiento y rotación de cuotas para OpenAI Codex CLI.
Permite ejecutar múltiples cuentas de Codex en paralelo sin colisiones ni agotamiento cruzado.
"""

import sys
import os
import json
import time
import argparse
import urllib.request
import urllib.error
import urllib.parse
import shutil
import subprocess
import re
import queue
import threading
from datetime import datetime, timezone

if os.name != "nt":
    import select
else:
    select = None

_SCRIPT_DIR = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
_REPO_ROOT = os.path.dirname(_SCRIPT_DIR)
for _lib_candidate in (
    os.path.join(_REPO_ROOT, "lib"),
    os.path.join(_SCRIPT_DIR, "lib"),
    os.path.join(os.path.expanduser("~"), ".codexc", "lib"),
):
    if os.path.isdir(os.path.join(_lib_candidate, "platform")):
        _parent = os.path.dirname(_lib_candidate)
        if _parent not in sys.path:
            sys.path.insert(0, _parent)
        break

from lib.platform import (
    IS_WINDOWS,
    create_dir_link,
    ensure_private_dir,
    ensure_public_dir,
    get_dir_security_status,
    get_launcher_path,
    get_local_bin_dir,
    get_real_codex_bin as _platform_get_real_codex_bin,
    is_executable,
    resolve_real_home,
    set_executable_permissions,
    set_private_file_permissions,
    wrap_codex_command,
)

# Rutas estándar del sistema
REAL_HOME = resolve_real_home()
CODEXC_DIR = os.path.join(REAL_HOME, ".codexc")
CACHE_DIR = os.path.join(CODEXC_DIR, "cache")
HOMES_DIR = os.path.join(REAL_HOME, ".codexc_homes")
ACTIVE_FILE = os.path.join(CODEXC_DIR, "active")
DEFAULT_FILE = os.path.join(CODEXC_DIR, "default")
SYSTEM_CODEX_DIR = os.path.join(REAL_HOME, ".codex")
CENTRAL_CODEX_BIN = os.path.join(
    SYSTEM_CODEX_DIR, "packages", "standalone", "current", "bin",
    "codex.exe" if IS_WINDOWS else "codex",
)
LOCAL_BIN_DIR = get_local_bin_dir(REAL_HOME)

CACHE_TTL_SECONDS = 60
RESERVED_NAMES = {
    "codex", "codexc", "active", "default", "current",
    "bin", "skills", "packages", "cache", "null", "all"
}
ALIAS_REGEX = re.compile(r'^[a-zA-Z0-9_-]{1,32}$')
ANSI_REGEX = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')

# Códigos ANSI para formato visual en terminal
C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_RED = "\033[31m"
C_GREEN = "\033[32m"
C_YELLOW = "\033[33m"
C_BLUE = "\033[34m"
C_MAGENTA = "\033[35m"
C_CYAN = "\033[36m"
C_WHITE = "\033[37m"
C_BG_GREEN = "\033[42m\033[30m"
C_BG_BLUE = "\033[44m\033[30m"

def validate_alias(alias: str) -> str:
    """Valida estrictamente el nombre del alias para evitar path traversal o inyecciones."""
    if not alias or not isinstance(alias, str):
        raise ValueError("El alias no puede estar vacío.")
    cleaned = alias.strip()
    if not ALIAS_REGEX.match(cleaned):
        raise ValueError(f"Alias inválido '{alias}'. Solo caracteres alfanuméricos, guiones y guiones bajos (máx 32).")
    if cleaned.lower() in RESERVED_NAMES:
        raise ValueError(f"El alias '{alias}' es un nombre reservado del sistema.")
    return cleaned

def ensure_base_dirs():
    ensure_private_dir(CODEXC_DIR)
    ensure_private_dir(CACHE_DIR)
    ensure_private_dir(HOMES_DIR)
    ensure_public_dir(LOCAL_BIN_DIR)

def get_real_codex_bin() -> str:
    return _platform_get_real_codex_bin(REAL_HOME, LOCAL_BIN_DIR)

def list_aliases() -> list[str]:
    ensure_base_dirs()
    if not os.path.exists(HOMES_DIR):
        return []
    items = []
    for entry in os.listdir(HOMES_DIR):
        full = os.path.join(HOMES_DIR, entry)
        if os.path.isdir(full) and entry.startswith("codex") and entry.lower() not in RESERVED_NAMES:
            if os.path.isfile(os.path.join(full, "auth.json")):
                items.append(entry)
    items.sort()
    return items

def get_active_alias() -> str:
    if os.path.isfile(ACTIVE_FILE):
        try:
            with open(ACTIVE_FILE, "r", encoding="utf-8") as f:
                val = f.read().strip()
                if val and val in list_aliases():
                    return val
        except Exception:
            pass
    return get_default_alias()

def get_default_alias() -> str:
    if os.path.isfile(DEFAULT_FILE):
        try:
            with open(DEFAULT_FILE, "r", encoding="utf-8") as f:
                val = f.read().strip()
                if val and val in list_aliases():
                    return val
        except Exception:
            pass
    aliases = list_aliases()
    return aliases[0] if aliases else "codex01"

def set_active_alias(alias: str):
    ensure_base_dirs()
    val = validate_alias(alias)
    with open(ACTIVE_FILE, "w", encoding="utf-8") as f:
        f.write(val + "\n")

def set_default_alias(alias: str):
    ensure_base_dirs()
    val = validate_alias(alias)
    with open(DEFAULT_FILE, "w", encoding="utf-8") as f:
        f.write(val + "\n")

def get_profile_dir(alias: str) -> str:
    val = validate_alias(alias)
    return os.path.join(HOMES_DIR, val)

def get_profile_auth_file(alias: str) -> str:
    return os.path.join(get_profile_dir(alias), "auth.json")

def format_countdown_from_seconds(secs: int | float | None) -> str:
    if secs is None:
        return "N/A"
    s = int(max(0, secs))
    if s <= 0:
        return "Disponible"
    days = s // 86400
    hours = (s % 86400) // 3600
    mins = (s % 3600) // 60
    if days > 0:
        return f"{days}d {hours:02d}h"
    if hours > 0:
        return f"{hours}h {mins:02d}m"
    return f"{mins}m"

def make_linebar(fraction: float | None, length: int = 10) -> str:
    if fraction is None:
        return f"{C_DIM}[{'-' * length}]  N/A{C_RESET}"
    pct = max(0.0, min(1.0, float(fraction)))
    filled = int(round(pct * length))
    empty = length - filled
    pct_int = int(round(pct * 100))
    if pct >= 0.5:
        color = C_GREEN
    elif pct >= 0.2:
        color = C_YELLOW
    else:
        color = C_RED
    bar = "█" * filled + "░" * empty
    return f"{color}[{bar}] {pct_int:3d}%{C_RESET}"

def visible_len(s: str) -> int:
    return len(ANSI_REGEX.sub('', s))

def pad_visible(s: str, width: int) -> str:
    vis_len = visible_len(s)
    padding = max(0, width - vis_len)
    return s + (" " * padding)

def _parse_account_refresh_line(line_bytes: bytes) -> bool:
    """Evalúa una línea JSON-RPC de app-server para confirmar account/read."""
    line = line_bytes.decode("utf-8", errors="replace").strip()
    if not line:
        return False
    try:
        data = json.loads(line)
        if data.get("id") == 2:
            res = data.get("result", {})
            return bool(res.get("account"))
    except Exception:
        return False
    return False


def attempt_native_token_refresh(alias: str) -> bool:
    """Renueva el token de autenticación delegando de forma segura y exclusiva al
    protocolo nativo app-server de Codex (account/read refreshToken=true).
    Esto garantiza sincronización de locks internos de Codex, cero condiciones de
    carrera y persistencia oficial."""
    prof_dir = get_profile_dir(alias)
    real_bin = get_real_codex_bin()
    if not (os.path.isdir(prof_dir) and os.path.isfile(real_bin)):
        return False

    env = os.environ.copy()
    env["CODEX_HOME"] = prof_dir
    cmd = wrap_codex_command(real_bin, ["app-server", "--listen", "stdio://"])
    p = None
    try:
        p = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=env,
            text=False,
        )
        init_req = {
            "id": 1,
            "method": "initialize",
            "params": {"clientInfo": {"name": "codexc", "version": "1.0.0"}},
        }
        acc_req = {
            "id": 2,
            "method": "account/read",
            "params": {"refreshToken": True},
        }
        payload = (json.dumps(init_req) + "\n" + json.dumps(acc_req) + "\n").encode("utf-8")
        try:
            p.stdin.write(payload)
            p.stdin.flush()
        except Exception:
            pass

        refreshed = False
        start_t = time.monotonic()
        deadline = 6.0  # máximo 6 segundos para responder

        if IS_WINDOWS or select is None:
            line_queue: queue.Queue[bytes | None] = queue.Queue()

            def _reader_worker():
                try:
                    while True:
                        raw = p.stdout.readline()
                        if isinstance(raw, str):
                            raw = raw.encode("utf-8")
                        if not raw:
                            break
                        line_queue.put(raw)
                except Exception:
                    pass
                finally:
                    line_queue.put(None)

            reader = threading.Thread(target=_reader_worker, daemon=True)
            reader.start()

            while time.monotonic() - start_t < deadline:
                remaining = max(0.05, deadline - (time.monotonic() - start_t))
                try:
                    item = line_queue.get(timeout=min(0.2, remaining))
                except queue.Empty:
                    continue
                if item is None:
                    break
                if _parse_account_refresh_line(item):
                    refreshed = True
                    break
        else:
            buffer = b""
            is_real_fd = False
            fd = None
            try:
                fd = p.stdout.fileno()
                os.set_blocking(fd, False)
                is_real_fd = True
            except Exception:
                is_real_fd = False

            while time.monotonic() - start_t < deadline:
                remaining = max(0.05, deadline - (time.monotonic() - start_t))
                if is_real_fd:
                    rlist, _, _ = select.select([fd], [], [], min(0.2, remaining))
                    if rlist:
                        try:
                            chunk = os.read(fd, 8192)
                            if not chunk:
                                break
                            buffer += chunk
                        except (BlockingIOError, InterruptedError):
                            pass
                        except Exception:
                            break
                else:
                    # Fallback para mocks de prueba o streams sin fd
                    try:
                        chunk = p.stdout.readline()
                        if isinstance(chunk, str):
                            chunk = chunk.encode("utf-8")
                        if not chunk:
                            break
                        buffer += chunk
                    except Exception:
                        break

                # Parsear líneas acumuladas
                while b"\n" in buffer:
                    line_bytes, buffer = buffer.split(b"\n", 1)
                    if _parse_account_refresh_line(line_bytes):
                        refreshed = True
                        break

                if refreshed:
                    break

        return refreshed
    except Exception:
        return False
    finally:
        if p is not None:
            try:
                if p.stdin:
                    p.stdin.close()
            except Exception:
                pass
            try:
                p.terminate()
                p.wait(timeout=0.8)
            except Exception:
                pass
            if p.poll() is None:
                try:
                    p.kill()
                    p.wait(timeout=1.0)
                except Exception:
                    pass

def fetch_codex_usage(alias: str, force_refresh: bool = False, retry_on_401: bool = True) -> dict:
    """Consulta la API en vivo de OpenAI ChatGPT con caché privada y manejo robusto de cuotas ausentes."""
    ensure_base_dirs()
    val_alias = validate_alias(alias)
    cache_file = os.path.join(CACHE_DIR, f"{val_alias}.json")
    now_ts = time.time()

    if not force_refresh and os.path.isfile(cache_file):
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                cached = json.load(f)
                if now_ts - cached.get("cached_at", 0) < CACHE_TTL_SECONDS:
                    # Recalcular countdowns dinámicamente desde reset_at
                    prim = cached.get("primary_window")
                    if isinstance(prim, dict) and prim.get("reset_at"):
                        diff = max(0, prim["reset_at"] - now_ts)
                        prim["reset_after_seconds"] = diff
                        prim["reset_str"] = format_countdown_from_seconds(diff)

                    sec = cached.get("secondary_window")
                    if isinstance(sec, dict) and sec.get("reset_at"):
                        diff = max(0, sec["reset_at"] - now_ts)
                        sec["reset_after_seconds"] = diff
                        sec["reset_str"] = format_countdown_from_seconds(diff)

                    return cached
        except Exception:
            pass

    auth_file = get_profile_auth_file(val_alias)
    if not os.path.isfile(auth_file):
        return {
            "alias": val_alias,
            "error": "auth_missing",
            "message": "Archivo auth.json no encontrado",
            "cached_at": now_ts
        }

    try:
        with open(auth_file, "r", encoding="utf-8") as f:
            auth_data = json.load(f)
    except Exception as e:
        return {"alias": val_alias, "error": "auth_invalid", "message": str(e), "cached_at": now_ts}

    tokens = auth_data.get("tokens", {})
    access_token = tokens.get("access_token")
    account_id = tokens.get("account_id")

    if not access_token:
        return {"alias": val_alias, "error": "token_missing", "message": "Access token ausente en auth.json", "cached_at": now_ts}

    headers = {
        "Authorization": f"Bearer {access_token}",
        "User-Agent": "codex-cli/0.164.0",
        "Accept": "application/json"
    }
    if account_id:
        headers["chatgpt-account-id"] = account_id

    url = "https://chatgpt.com/backend-api/codex/usage"
    req = urllib.request.Request(url, headers=headers)

    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 401 and retry_on_401:
            # Intento único de auto-renovación mediante el motor nativo de Codex
            if attempt_native_token_refresh(val_alias):
                return fetch_codex_usage(val_alias, force_refresh=True, retry_on_401=False)
            return {"alias": val_alias, "error": "token_expired", "message": "Token expirado o revocado (HTTP 401)", "cached_at": now_ts}
        return {"alias": val_alias, "error": "http_error", "message": f"HTTP {e.code}: {e.reason}", "cached_at": now_ts}
    except Exception as e:
        return {"alias": val_alias, "error": "network_error", "message": str(e), "cached_at": now_ts}

    # Normalización estricta de métricas (no asumir 100% si viene ausente o null)
    rate_limit = data.get("rate_limit")
    if not isinstance(rate_limit, dict):
        rate_limit = {}

    allowed = rate_limit.get("allowed", True)
    limit_reached = rate_limit.get("limit_reached", False)

    prim = rate_limit.get("primary_window")
    if isinstance(prim, dict):
        p_used = prim.get("used_percent")
        p_rem_frac = max(0.0, min(1.0, (100.0 - float(p_used)) / 100.0)) if p_used is not None else None
        p_reset_at = prim.get("reset_at")
        p_reset_sec = max(0, p_reset_at - now_ts) if p_reset_at else prim.get("reset_after_seconds")
        p_window_data = {
            "used_percent": p_used,
            "remaining_fraction": p_rem_frac,
            "reset_at": p_reset_at,
            "reset_after_seconds": p_reset_sec,
            "reset_str": format_countdown_from_seconds(p_reset_sec) if p_reset_sec is not None else "N/A",
        }
    else:
        p_window_data = {
            "used_percent": None,
            "remaining_fraction": None,
            "reset_at": None,
            "reset_after_seconds": None,
            "reset_str": "N/A",
        }

    sec = rate_limit.get("secondary_window")
    if isinstance(sec, dict):
        s_used = sec.get("used_percent")
        s_rem_frac = max(0.0, min(1.0, (100.0 - float(s_used)) / 100.0)) if s_used is not None else None
        s_reset_at = sec.get("reset_at")
        s_reset_sec = max(0, s_reset_at - now_ts) if s_reset_at else sec.get("reset_after_seconds")
        s_window_data = {
            "used_percent": s_used,
            "remaining_fraction": s_rem_frac,
            "reset_at": s_reset_at,
            "reset_after_seconds": s_reset_sec,
            "reset_str": format_countdown_from_seconds(s_reset_sec) if s_reset_sec is not None else "N/A",
        }
    else:
        s_window_data = {
            "used_percent": None,
            "remaining_fraction": None,
            "reset_at": None,
            "reset_after_seconds": None,
            "reset_str": "N/A",
        }

    metrics = {
        "alias": val_alias,
        "email": data.get("email"),
        "user_id": data.get("user_id"),
        "account_id": data.get("account_id"),
        "plan_type": data.get("plan_type", "plus"),
        "primary_window": p_window_data,
        "secondary_window": s_window_data,
        "allowed": allowed,
        "limit_reached": limit_reached,
        "cached_at": now_ts
    }

    # Escritura atómica y con permisos privados 0600 en CACHE_DIR
    try:
        tmp_cache = cache_file + f".tmp.{os.getpid()}"
        with open(tmp_cache, "w", encoding="utf-8") as f:
            json.dump(metrics, f)
        set_private_file_permissions(tmp_cache)
        os.replace(tmp_cache, cache_file)
    except Exception:
        pass

    return metrics

def ensure_auto_migration():
    """Migra de forma no destructiva la cuenta existente en ~/.codex hacia codex01 si no hay perfiles."""
    aliases = list_aliases()
    if aliases:
        return
    auth_src = os.path.join(SYSTEM_CODEX_DIR, "auth.json")
    if not os.path.isfile(auth_src):
        return

    prof_dir = get_profile_dir("codex01")
    ensure_private_dir(prof_dir)

    auth_dst = os.path.join(prof_dir, "auth.json")
    if not os.path.exists(auth_dst):
        shutil.copy2(auth_src, auth_dst)
        set_private_file_permissions(auth_dst)

    cfg_src = os.path.join(SYSTEM_CODEX_DIR, "config.toml")
    cfg_dst = os.path.join(prof_dir, "config.toml")
    if os.path.isfile(cfg_src) and not os.path.exists(cfg_dst):
        shutil.copy2(cfg_src, cfg_dst)
        set_private_file_permissions(cfg_dst)

    skills_src = os.path.join(SYSTEM_CODEX_DIR, "skills")
    skills_dst = os.path.join(prof_dir, "skills")
    if os.path.isdir(skills_src) and not os.path.exists(skills_dst):
        create_dir_link(skills_src, skills_dst)

    set_active_alias("codex01")
    set_default_alias("codex01")
    sync_launchers()


KNOWN_SUBS_STR = (
    " agents exec review login logout mcp plugin app-server remote-control "
    "completion update doctor sandbox debug apply resume queue archive delete "
    "migrate-rollouts migrate-nfs-db unarchive fork cloud exec-server features help "
)


def _write_launcher_if_changed(path: str, content: str, newline: str | None = None) -> None:
    """Escribe un lanzador solo si su contenido cambió, evitando escrituras redundantes."""
    need_write = True
    if os.path.isfile(path) and not os.path.islink(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                if f.read().replace("\r\n", "\n") == content.replace("\r\n", "\n"):
                    need_write = False
        except Exception:
            pass
    if need_write:
        if os.path.islink(path):
            os.remove(path)
        with open(path, "w", encoding="utf-8", newline=newline) as f:
            f.write(content)
        set_executable_permissions(path)


def _build_cmd_launcher_body(real_bin: str) -> str:
    """Genera el bloque común de parseo de argumentos y --yolo para lanzadores .cmd."""
    return f"""set "REAL_BIN={real_bin}"
set "KNOWN_SUBS={KNOWN_SUBS_STR}"

set "HAS_YOLO=0"
set "HAS_NO_YOLO=0"
set "IS_SUBCMD=0"
set "FIRST_POS="
set "ARGS="

:parse_loop
if "%~1"=="" goto after_parse
set "ARG=%~1"
if "%ARG%"=="--yolo" goto mark_yolo
if "%ARG%"=="--dangerously-bypass-approvals-and-sandbox" goto mark_yolo
if "%ARG%"=="--no-yolo" goto mark_no_yolo
set "ARGS=%ARGS% %1"
if defined FIRST_POS goto next_arg
if "%ARG:~0,1%"=="-" goto next_arg
set "FIRST_POS=%ARG%"
goto next_arg

:mark_yolo
set "HAS_YOLO=1"
set "ARGS=%ARGS% %1"
goto next_arg

:mark_no_yolo
set "HAS_NO_YOLO=1"

:next_arg
shift
goto parse_loop

:after_parse
if not defined FIRST_POS goto check_yolo
echo "%KNOWN_SUBS%" | findstr /L /C:" %FIRST_POS% " >nul 2>&1
if not errorlevel 1 set "IS_SUBCMD=1"

:check_yolo
if "%HAS_NO_YOLO%"=="0" if "%HAS_YOLO%"=="0" if "%IS_SUBCMD%"=="0" goto run_yolo
ver >nul
call "%REAL_BIN%" %ARGS%
exit /b %ERRORLEVEL%

:run_yolo
ver >nul
call "%REAL_BIN%" --yolo %ARGS%
exit /b %ERRORLEVEL%
"""


def _build_bash_launcher(alias: str, prof_dir: str, real_bin: str) -> str:
    return f"""#!/usr/bin/env bash
# Lanzador aislado para {alias} generado por codexc (modo --yolo por defecto)
export CODEX_HOME="{prof_dir}"

KNOWN_SUBS="{KNOWN_SUBS_STR}"

has_yolo=false
has_no_yolo=false
is_subcmd=false

ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--yolo" ] || [ "$arg" = "--dangerously-bypass-approvals-and-sandbox" ]; then
        has_yolo=true
    elif [ "$arg" = "--no-yolo" ]; then
        has_no_yolo=true
        continue
    fi
    ARGS+=("$arg")
done

for arg in "${{ARGS[@]}}"; do
    case "$arg" in
        -*) ;;
        *)
            if [[ "$KNOWN_SUBS" =~ " $arg " ]]; then
                is_subcmd=true
            fi
            break
            ;;
    esac
done

if [ "$has_no_yolo" = false ] && [ "$has_yolo" = false ] && [ "$is_subcmd" = false ]; then
    exec "{real_bin}" --yolo "${{ARGS[@]}}"
else
    exec "{real_bin}" "${{ARGS[@]}}"
fi
"""


def _build_bash_wrapper(real_bin: str) -> str:
    return f"""#!/usr/bin/env bash
# Wrapper inteligente para 'codex' administrado por codexc (modo --yolo por defecto)
REAL_BIN="{real_bin}"
if [ -z "$CODEX_HOME" ]; then
    ACTIVE_FILE="{ACTIVE_FILE}"
    DEFAULT_FILE="{DEFAULT_FILE}"
    if [ -f "$ACTIVE_FILE" ]; then
        ACTIVE=$(cat "$ACTIVE_FILE" 2>/dev/null | tr -d '[:space:]')
    elif [ -f "$DEFAULT_FILE" ]; then
        ACTIVE=$(cat "$DEFAULT_FILE" 2>/dev/null | tr -d '[:space:]')
    else
        ACTIVE="codex01"
    fi
    TARGET_HOME="{HOMES_DIR}/$ACTIVE"
    if [ -d "$TARGET_HOME" ]; then
        export CODEX_HOME="$TARGET_HOME"
    fi
fi

KNOWN_SUBS="{KNOWN_SUBS_STR}"

has_yolo=false
has_no_yolo=false
is_subcmd=false

ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--yolo" ] || [ "$arg" = "--dangerously-bypass-approvals-and-sandbox" ]; then
        has_yolo=true
    elif [ "$arg" = "--no-yolo" ]; then
        has_no_yolo=true
        continue
    fi
    ARGS+=("$arg")
done

for arg in "${{ARGS[@]}}"; do
    case "$arg" in
        -*) ;;
        *)
            if [[ "$KNOWN_SUBS" =~ " $arg " ]]; then
                is_subcmd=true
            fi
            break
            ;;
    esac
done

if [ "$has_no_yolo" = false ] && [ "$has_yolo" = false ] && [ "$is_subcmd" = false ]; then
    exec "$REAL_BIN" --yolo "${{ARGS[@]}}"
else
    exec "$REAL_BIN" "${{ARGS[@]}}"
fi
"""


def sync_launchers():
    """Sincroniza binarios lanzadores sin escrituras redundantes ni sobreescritura de symlinks ajenos."""
    ensure_base_dirs()
    real_bin = get_real_codex_bin()
    aliases = list_aliases()
    current_script = os.path.realpath(os.path.abspath(__file__))

    if IS_WINDOWS:
        # 1. Lanzadores .cmd por cada cuenta (codex01.cmd, codex02.cmd...)
        for alias in aliases:
            launcher_path = get_launcher_path(LOCAL_BIN_DIR, alias)
            prof_dir = get_profile_dir(alias)
            content = (
                "@echo off\n"
                "setlocal\n"
                f'rem Lanzador aislado para {alias} generado por codexc (modo --yolo por defecto)\n'
                f'set "CODEX_HOME={prof_dir}"\n'
                + _build_cmd_launcher_body(real_bin)
            )
            _write_launcher_if_changed(launcher_path, content, newline="\r\n")

        # 2. Wrapper codex.cmd
        wrapper_path = os.path.join(LOCAL_BIN_DIR, "codex.cmd")
        wrapper_content = (
            "@echo off\n"
            "setlocal\n"
            "rem Wrapper inteligente para 'codex' administrado por codexc (modo --yolo por defecto)\n"
            "if not defined CODEX_HOME (\n"
            '    set "ACTIVE="\n'
            f'    if exist "{ACTIVE_FILE}" (\n'
            f'        set /p ACTIVE=<"{ACTIVE_FILE}"\n'
            f'    ) else if exist "{DEFAULT_FILE}" (\n'
            f'        set /p ACTIVE=<"{DEFAULT_FILE}"\n'
            "    ) else (\n"
            '        set "ACTIVE=codex01"\n'
            "    )\n"
            '    if not defined ACTIVE set "ACTIVE=codex01"\n'
            '    set "ACTIVE=%ACTIVE: =%"\n'
            f'    if exist "{HOMES_DIR}\\%ACTIVE%" (\n'
            f'        set "CODEX_HOME={HOMES_DIR}\\%ACTIVE%"\n'
            "    )\n"
            ")\n"
            + _build_cmd_launcher_body(real_bin)
        )
        _write_launcher_if_changed(wrapper_path, wrapper_content, newline="\r\n")

        # 3. Lanzador global codexc.cmd
        codexc_cmd_path = os.path.join(LOCAL_BIN_DIR, "codexc.cmd")
        codexc_cmd_content = (
            "@echo off\n"
            f'"{sys.executable}" "{current_script}" %*\n'
        )
        _write_launcher_if_changed(codexc_cmd_path, codexc_cmd_content, newline="\r\n")
        return

    # Linux / POSIX
    for alias in aliases:
        launcher_path = get_launcher_path(LOCAL_BIN_DIR, alias)
        content = _build_bash_launcher(alias, get_profile_dir(alias), real_bin)
        _write_launcher_if_changed(launcher_path, content)

    wrapper_path = os.path.join(LOCAL_BIN_DIR, "codex")
    wrapper_content = _build_bash_wrapper(real_bin)
    _write_launcher_if_changed(wrapper_path, wrapper_content)

    # 3. Symlink global para 'codexc'
    codexc_target = os.path.join(LOCAL_BIN_DIR, "codexc")
    target_abs = os.path.abspath(codexc_target)
    if current_script != target_abs:
        need_link = True
        if os.path.islink(codexc_target):
            try:
                if os.path.realpath(codexc_target) == current_script:
                    need_link = False
            except Exception:
                pass
        if need_link:
            try:
                if os.path.lexists(codexc_target):
                    os.remove(codexc_target)
                os.symlink(current_script, codexc_target)
            except Exception:
                pass

def cmd_list(args):
    ensure_auto_migration()
    sync_launchers()

    aliases = list_aliases()
    if not aliases:
        if getattr(args, "json", False):
            print(json.dumps({"active_account": None, "default_account": None, "accounts": []}, indent=2))
            return
        print(f"\n{C_YELLOW}No hay perfiles de Codex configurados.{C_RESET}")
        print(f"Usa '{C_CYAN}codexc add codex01{C_RESET}' para vincular tu primera cuenta.\n")
        return

    active = get_active_alias()
    default = get_default_alias()

    accounts_data = []
    force_ref = getattr(args, "refresh", False)

    for alias in aliases:
        usage = fetch_codex_usage(alias, force_refresh=force_ref)
        accounts_data.append({
            "alias": alias,
            "is_active": (alias == active),
            "is_default": (alias == default),
            "usage": usage
        })

    if getattr(args, "json", False):
        print(json.dumps({
            "active_account": active,
            "default_account": default,
            "accounts": accounts_data
        }, indent=2))
        return

    col_alias = 11
    col_email = 30
    col_plan = 10
    col_state = 15
    col_5h = 32
    col_week = 32

    border_top = f"┌{'─' * col_alias}┬{'─' * col_email}┬{'─' * col_plan}┬{'─' * col_state}┬{'─' * col_5h}┬{'─' * col_week}┐"
    border_mid = f"├{'─' * col_alias}┼{'─' * col_email}┼{'─' * col_plan}┼{'─' * col_state}┼{'─' * col_5h}┼{'─' * col_week}┤"
    border_bot = f"└{'─' * col_alias}┴{'─' * col_email}┴{'─' * col_plan}┴{'─' * col_state}┴{'─' * col_5h}┴{'─' * col_week}┘"

    header_title = f"{C_BOLD}{C_WHITE}PANEL DE CUENTAS DE OPENAI CODEX (CODEXC SWITCHER){C_RESET}"
    print(header_title)
    print(f"{C_DIM}Desarrollo en paralelo: consumo de tokens en ventana de 5 Horas y Semanal.{C_RESET}\n")

    print(border_top)
    hdr = (
        f"│ {pad_visible(C_BOLD + 'ALIAS' + C_RESET, col_alias - 2)} "
        f"│ {pad_visible(C_BOLD + 'CUENTA / EMAIL' + C_RESET, col_email - 2)} "
        f"│ {pad_visible(C_BOLD + 'PLAN' + C_RESET, col_plan - 2)} "
        f"│ {pad_visible(C_BOLD + 'ESTADO' + C_RESET, col_state - 2)} "
        f"│ {pad_visible(C_BOLD + '5 HORAS (DISPONIBLE / RESET)' + C_RESET, col_5h - 2)} "
        f"│ {pad_visible(C_BOLD + 'SEMANAL (DISPONIBLE / RESET)' + C_RESET, col_week - 2)} │"
    )
    print(hdr)
    print(border_mid)

    for i, item in enumerate(accounts_data):
        alias = item["alias"]
        is_act = item["is_active"]
        is_def = item["is_default"]
        usage = item["usage"]

        if is_act and is_def:
            state_str = f"{C_BG_GREEN}*ACTIVA+DEF{C_RESET}"
            alias_disp = f"{C_BOLD}{C_GREEN}* {alias}{C_RESET}"
        elif is_act:
            state_str = f"{C_GREEN}* ACTIVA{C_RESET}"
            alias_disp = f"{C_BOLD}{C_GREEN}* {alias}{C_RESET}"
        elif is_def:
            state_str = f"{C_CYAN}  DEFAULT{C_RESET}"
            alias_disp = f"  {alias}"
        else:
            state_str = f"{C_DIM}  LISTA{C_RESET}"
            alias_disp = f"  {alias}"

        if "error" in usage:
            email_disp = f"{C_RED}Error de auth{C_RESET}"
            plan_disp = "-"
            p5_disp = f"{C_RED}{usage.get('message', 'Error')}{C_RESET}"
            pw_disp = f"{C_DIM}Re-vincular cuenta{C_RESET}"
        else:
            email = usage.get("email") or "(email no disponible)"
            if len(email) > col_email - 2:
                email_disp = email[:col_email - 5] + "..."
            else:
                email_disp = email

            plan_disp = (usage.get("plan_type") or "plus").upper()
            if plan_disp == "PRO":
                plan_disp = f"{C_MAGENTA}{plan_disp}{C_RESET}"
            elif plan_disp == "TEAM":
                plan_disp = f"{C_CYAN}{plan_disp}{C_RESET}"

            prim = usage.get("primary_window", {})
            sec = usage.get("secondary_window", {})

            p5_frac = prim.get("remaining_fraction")
            p5_rst = prim.get("reset_str", "N/A")

            pw_frac = sec.get("remaining_fraction")
            pw_rst = sec.get("reset_str", "N/A")

            p5_disp = f"5H:  {make_linebar(p5_frac, length=8)} ({p5_rst})"
            pw_disp = f"Sem: {make_linebar(pw_frac, length=8)} ({pw_rst})"

        row = (
            f"│ {pad_visible(alias_disp, col_alias - 2)} "
            f"│ {pad_visible(email_disp, col_email - 2)} "
            f"│ {pad_visible(plan_disp, col_plan - 2)} "
            f"│ {pad_visible(state_str, col_state - 2)} "
            f"│ {pad_visible(p5_disp, col_5h - 2)} "
            f"│ {pad_visible(pw_disp, col_week - 2)} │"
        )
        print(row)
        if i < len(accounts_data) - 1:
            print(border_mid)

    print(border_bot)

    print("\nAtajos rápidos para desarrollo en paralelo:")
    print(f"  • Ejecución directa fija:  {C_CYAN}codex01{C_RESET} | {C_CYAN}codex02{C_RESET} (aisladas sin tocarse)")
    print(f"  • Cambiar cuenta activa:   {C_CYAN}codexc switch <alias>{C_RESET} (o 'codexc <alias>')")
    print(f"  • Agregar nueva cuenta:    {C_CYAN}codexc add [alias]{C_RESET} (asigna correlativo en automático)")
    print(f"  • Rotación automática:     {C_CYAN}codexc auto{C_RESET} (selecciona la cuenta con mayor saldo)")
    print(f"  • Diagnóstico de perfiles: {C_CYAN}codexc doctor{C_RESET}\n")

def cmd_switch(args):
    ensure_auto_migration()
    alias = validate_alias(args.alias)
    aliases = list_aliases()
    if alias not in aliases:
        print(f"{C_RED}Error:{C_RESET} El alias '{alias}' no existe.")
        print(f"Cuentas disponibles: {', '.join(aliases)}")
        sys.exit(1)

    set_active_alias(alias)
    sync_launchers()
    usage = fetch_codex_usage(alias)
    email = usage.get("email") or "cuenta"
    print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta activa cambiada a: {alias} ({email}){C_RESET}")
    print(f"{C_DIM}A partir de ahora, el comando 'codex' utilizará el perfil {alias}.{C_RESET}")
    print(f"{C_DIM}Para usar cuentas específicas en paralelo, usa siempre 'codex01' o 'codex02'.{C_RESET}\n")

def cmd_default(args):
    ensure_auto_migration()
    alias = validate_alias(args.alias)
    aliases = list_aliases()
    if alias not in aliases:
        print(f"{C_RED}Error:{C_RESET} El alias '{alias}' no existe.")
        print(f"Cuentas disponibles: {', '.join(aliases)}")
        sys.exit(1)

    set_default_alias(alias)
    print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta predeterminada configurada como: {alias}{C_RESET}\n")

def cmd_add(args):
    ensure_auto_migration()
    aliases = list_aliases()

    raw_alias = args.alias
    if not raw_alias:
        idx = 1
        while f"codex{idx:02d}" in aliases:
            idx += 1
        alias = f"codex{idx:02d}"
    else:
        try:
            alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"\n{C_RED}Error:{C_RESET} {e}\n")
            sys.exit(1)

    prof_dir = get_profile_dir(alias)
    auth_file = get_profile_auth_file(alias)

    # Protección contra sobreescritura accidental de perfil existente
    if alias in aliases or os.path.isfile(auth_file):
        print(f"\n{C_RED}Error:{C_RESET} El perfil '{alias}' ya existe.")
        print(f"Para re-autenticar usa 'codexc login {alias}', o elimina el perfil primero con 'codexc rm {alias}'.\n")
        sys.exit(1)

    ensure_private_dir(prof_dir)

    # Copiar configuración base si no existe
    cfg_dst = os.path.join(prof_dir, "config.toml")
    if not os.path.exists(cfg_dst):
        cfg_src = os.path.join(SYSTEM_CODEX_DIR, "config.toml")
        if os.path.isfile(cfg_src):
            shutil.copy2(cfg_src, cfg_dst)
            set_private_file_permissions(cfg_dst)

    # Enlazar skills si existen
    skills_dst = os.path.join(prof_dir, "skills")
    if not os.path.exists(skills_dst):
        skills_src = os.path.join(SYSTEM_CODEX_DIR, "skills")
        if os.path.isdir(skills_src):
            create_dir_link(skills_src, skills_dst)

    real_bin = get_real_codex_bin()
    print(f"\n{C_BOLD}{C_CYAN}▶ Iniciando vinculación de cuenta para '{alias}'...{C_RESET}")
    print(f"{C_DIM}CODEX_HOME={prof_dir}{C_RESET}")

    env = os.environ.copy()
    env["CODEX_HOME"] = prof_dir

    login_args = ["login"]
    if getattr(args, "device_auth", False):
        login_args.append("--device-auth")
    login_cmd = wrap_codex_command(real_bin, login_args)

    try:
        subprocess.run(login_cmd, env=env, check=True)
    except (subprocess.CalledProcessError, KeyboardInterrupt):
        # Si fue cancelado o falló, limpiar directorio para no dejar perfil zombie
        if not os.path.isfile(auth_file):
            shutil.rmtree(prof_dir, ignore_errors=True)
        print(f"\n{C_RED}Inicio de sesión cancelado o fallido.{C_RESET}\n")
        sys.exit(1)

    if not os.path.isfile(auth_file):
        shutil.rmtree(prof_dir, ignore_errors=True)
        print(f"\n{C_RED}Error:{C_RESET} No se generó el archivo auth.json en {prof_dir}.\n")
        sys.exit(1)

    set_private_file_permissions(auth_file)

    # Validar cuota e identidad de la nueva cuenta
    usage = fetch_codex_usage(alias, force_refresh=True)
    email = usage.get("email")
    account_id = usage.get("account_id")

    # Detección estricta de cuentas duplicadas: bloquear y revertir
    for other in aliases:
        if other != alias:
            other_usage = fetch_codex_usage(other)
            other_email = other_usage.get("email")
            other_acc = other_usage.get("account_id")
            if (account_id and other_acc and account_id == other_acc) or (email and other_email and email.lower() == other_email.lower()):
                print(f"\n{C_BOLD}{C_RED}✗ Cuenta Duplicada Detectada:{C_RESET}")
                print(f"  El correo '{email}' (ID: {account_id}) ya está registrado como '{other}'.")
                print(f"  No se permite registrar perfiles duplicados que consuman la misma cuota de OpenAI.")
                print(f"  Eliminando perfil duplicado...")
                shutil.rmtree(prof_dir, ignore_errors=True)
                sys.exit(1)

    sync_launchers()
    set_active_alias(alias)

    print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta '{alias}' configurada exitosamente.{C_RESET}")
    if email:
        print(f"  Usuario: {email} (Plan: {(usage.get('plan_type') or 'plus').upper()})")
    print(f"  Lanzador disponible: {C_CYAN}{alias}{C_RESET}")
    print(f"  Cuenta activa ahora: {C_GREEN}{alias}{C_RESET}\n")

def cmd_auto(args):
    ensure_auto_migration()
    aliases = list_aliases()
    if not aliases:
        print(f"{C_RED}No hay cuentas disponibles.{C_RESET}")
        return

    print(f"\n{C_BOLD}Evaluando cuotas de {len(aliases)} cuentas de Codex...{C_RESET}")
    best_alias = None
    best_5h_frac = -1.0
    best_week_frac = -1.0

    for alias in aliases:
        usage = fetch_codex_usage(alias, force_refresh=True)
        if "error" in usage:
            print(f"  • {alias:<8}: {C_RED}[Error de autenticación]{C_RESET}")
            continue

        p5 = usage.get("primary_window", {})
        pw = usage.get("secondary_window", {})

        p5_frac = p5.get("remaining_fraction")
        pw_frac = pw.get("remaining_fraction")
        allowed = usage.get("allowed", True)
        limit_reached = usage.get("limit_reached", False)

        p5_pct = int(round(p5_frac * 100)) if p5_frac is not None else 0
        pw_pct = int(round(pw_frac * 100)) if pw_frac is not None else 0

        status_tag = ""
        is_blocked = False
        if limit_reached or not allowed:
            status_tag = f" {C_RED}[Límite Alcanzado / Bloqueada]{C_RESET}"
            is_blocked = True
        elif pw_frac is not None and pw_frac <= 0.001:
            status_tag = f" {C_RED}[Semanal Agotada]{C_RESET}"
            is_blocked = True
        elif p5_frac is not None and p5_frac <= 0.001:
            status_tag = f" {C_YELLOW}[5H Agotada]{C_RESET}"
            is_blocked = True

        p5_str = f"{p5_pct:3d}%" if p5_frac is not None else "N/A"
        pw_str = f"{pw_pct:3d}%" if pw_frac is not None else "N/A"
        print(f"  • {alias:<8} ({usage.get('email', 'desconocido')}): 5H = {p5_str} | Semanal = {pw_str}{status_tag}")

        if not is_blocked and p5_frac is not None and p5_frac > 0.001:
            if p5_frac > best_5h_frac:
                best_5h_frac = p5_frac
                best_week_frac = pw_frac if pw_frac is not None else 1.0
                best_alias = alias

    if best_alias:
        set_active_alias(best_alias)
        print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta óptima seleccionada: {best_alias} (5H disponible: {int(best_5h_frac*100)}%){C_RESET}\n")
    else:
        print(f"\n{C_BOLD}{C_YELLOW}⚠ Todas las cuentas están en límite de cuota o bloqueadas.{C_RESET}\n")

def cmd_quota(args):
    ensure_auto_migration()
    raw_alias = args.alias or get_active_alias()
    try:
        alias = validate_alias(raw_alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)

    aliases = list_aliases()
    if alias not in aliases:
        print(f"{C_RED}Error:{C_RESET} El alias '{alias}' no existe.")
        sys.exit(1)

    usage = fetch_codex_usage(alias, force_refresh=True)
    if "error" in usage:
        print(f"\n{C_RED}Error:{C_RESET} {usage.get('message')}\n")
        return

    print(f"\n{C_BOLD}{C_CYAN}DETALLE DE CUOTA CODEX: {alias} ({usage.get('email')}){C_RESET}")
    print(f"  Plan: {(usage.get('plan_type') or 'plus').upper()} | Account ID: {usage.get('account_id')}")

    prim = usage.get("primary_window", {})
    sec = usage.get("secondary_window", {})

    print(f"\n  • Ventana 5 Horas:")
    print(f"    Restante:   {make_linebar(prim.get('remaining_fraction'), length=16)}")
    used_5h = prim.get('used_percent')
    print(f"    Consumido:  {f'{used_5h}%' if used_5h is not None else 'N/A'}")
    print(f"    Reinicio:   en {prim.get('reset_str', 'N/A')}")

    print(f"\n  • Ventana Semanal:")
    print(f"    Restante:   {make_linebar(sec.get('remaining_fraction'), length=16)}")
    used_w = sec.get('used_percent')
    print(f"    Consumido:  {f'{used_w}%' if used_w is not None else 'N/A'}")
    print(f"    Reinicio:   en {sec.get('reset_str', 'N/A')}")
    print("")

def cmd_doctor(args):
    ensure_auto_migration()
    sync_launchers()
    print(f"\n{C_BOLD}{C_WHITE}DIAGNÓSTICO DE CODEXC SWITCHER{C_RESET}\n")
    real_bin = get_real_codex_bin()
    print(f"  Binario real de Codex:  {real_bin} ({'✓ Encontrado' if is_executable(real_bin) else '✗ NO ENCONTRADO'})")
    print(f"  Directorio de perfiles: {HOMES_DIR}")
    print(f"  Directorio de caché:    {CACHE_DIR} ({get_dir_security_status(CACHE_DIR)})")
    print(f"  Cuenta activa:          {get_active_alias()}")
    print(f"  Cuenta default:         {get_default_alias()}")

    aliases = list_aliases()
    print(f"\n  Perfiles registrados ({len(aliases)}):")
    for alias in aliases:
        prof = get_profile_dir(alias)
        auth = get_profile_auth_file(alias)
        launcher = get_launcher_path(LOCAL_BIN_DIR, alias)

        prof_ok = os.path.isdir(prof)
        auth_ok = os.path.isfile(auth)
        launch_ok = is_executable(launcher)

        status_parts = []
        status_parts.append(f"dir: {'✓' if prof_ok else '✗'}")
        status_parts.append(f"auth: {'✓' if auth_ok else '✗'}")
        status_parts.append(f"launcher: {'✓' if launch_ok else '✗'}")

        print(f"    • {alias:<8} [{', '.join(status_parts)}]")

    print(f"\n{C_GREEN}✓ Diagnóstico completado.{C_RESET}\n")

def cmd_rm(args):
    ensure_auto_migration()
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)

    aliases = list_aliases()
    if alias not in aliases:
        print(f"{C_RED}Error:{C_RESET} El alias '{alias}' no existe.")
        sys.exit(1)

    prof = get_profile_dir(alias)
    launcher = get_launcher_path(LOCAL_BIN_DIR, alias)
    cache_file = os.path.join(CACHE_DIR, f"{alias}.json")

    confirm = input(f"¿Estás seguro de eliminar el perfil '{alias}' ({prof})? [s/N]: ")
    if confirm.lower() not in ("s", "si", "y", "yes"):
        print("Operación cancelada.")
        return

    try:
        shutil.rmtree(prof, ignore_errors=True)
    except Exception as e:
        print(f"{C_RED}Error al borrar carpeta: {e}{C_RESET}")

    if os.path.lexists(launcher):
        try:
            os.remove(launcher)
        except Exception:
            pass

    if os.path.lexists(cache_file):
        try:
            os.remove(cache_file)
        except Exception:
            pass

    remaining = [a for a in aliases if a != alias]
    if remaining:
        if get_active_alias() == alias:
            set_active_alias(remaining[0])
            print(f"Cuenta activa reasignada a: {remaining[0]}")
        if get_default_alias() == alias:
            set_default_alias(remaining[0])
            print(f"Cuenta predeterminada reasignada a: {remaining[0]}")
    else:
        if os.path.isfile(ACTIVE_FILE):
            os.remove(ACTIVE_FILE)
        if os.path.isfile(DEFAULT_FILE):
            os.remove(DEFAULT_FILE)

    sync_launchers()
    print(f"{C_GREEN}✓ Perfil '{alias}' eliminado.{C_RESET}\n")


def _extract_auth_identity(auth_data: dict) -> tuple[str | None, str | None]:
    """Extrae (account_id, email) de un diccionario auth.json sin llamadas de red."""
    if not isinstance(auth_data, dict):
        return None, None
    tokens = auth_data.get("tokens")
    account_id = tokens.get("account_id") if isinstance(tokens, dict) else None
    email = auth_data.get("email")
    return account_id, email


def _get_existing_profile_identity(alias: str) -> tuple[str | None, str | None]:
    """Obtiene (account_id, email) de un perfil local desde auth.json y caché."""
    account_id = None
    email = None
    auth_file = get_profile_auth_file(alias)
    if os.path.isfile(auth_file):
        try:
            with open(auth_file, "r", encoding="utf-8") as f:
                account_id, email = _extract_auth_identity(json.load(f))
        except Exception:
            pass
    cache_file = os.path.join(CACHE_DIR, f"{alias}.json")
    if os.path.isfile(cache_file):
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                cached = json.load(f)
                account_id = account_id or cached.get("account_id")
                email = email or cached.get("email")
        except Exception:
            pass
    return account_id, email


def cmd_export(args):
    ensure_auto_migration()
    available = list_aliases()

    raw_alias = getattr(args, "alias", None)
    if raw_alias:
        try:
            alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
        if alias not in available:
            print(f"{C_RED}Error:{C_RESET} El alias '{alias}' no existe.")
            sys.exit(1)
        target_aliases = [alias]
        default_out = f"codexc-{alias}.json"
    else:
        if not available:
            print(f"{C_RED}Error:{C_RESET} No hay perfiles configurados para exportar.")
            sys.exit(1)
        target_aliases = available
        default_out = "codexc-accounts-bundle.json"

    accounts_payload = []
    for alias in target_aliases:
        auth_file = get_profile_auth_file(alias)
        if not os.path.isfile(auth_file):
            print(f"{C_RED}Error:{C_RESET} Falta auth.json en el perfil '{alias}'.")
            sys.exit(1)
        try:
            with open(auth_file, "r", encoding="utf-8") as f:
                auth_data = json.load(f)
        except Exception as e:
            print(f"{C_RED}Error:{C_RESET} No se pudo leer auth.json de '{alias}': {e}")
            sys.exit(1)

        entry = {"alias": alias, "auth": auth_data}
        cfg_file = os.path.join(get_profile_dir(alias), "config.toml")
        if os.path.isfile(cfg_file):
            try:
                with open(cfg_file, "r", encoding="utf-8") as f:
                    entry["config_toml"] = f.read()
            except Exception:
                pass
        accounts_payload.append(entry)

    bundle = {
        "format": "codexc-bundle-v1",
        "exported_at": datetime.now(timezone.utc).isoformat(),
        "accounts": accounts_payload,
    }

    out_path = getattr(args, "output", None) or default_out
    out_dir = os.path.dirname(os.path.abspath(out_path))
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(bundle, f, indent=2)
    set_private_file_permissions(out_path)

    print(f"\n{C_BOLD}{C_GREEN}✓ Exportación completada:{C_RESET} {out_path} ({len(accounts_payload)} cuenta(s))")
    print(
        f"{C_YELLOW}⚠ Advertencia de seguridad:{C_RESET} Este archivo contiene tokens de sesión privados.\n"
        f"  Transfiérelo únicamente por un canal cifrado (ej. scp) y elimínalo tras importarlo.\n"
    )


def cmd_import(args):
    ensure_base_dirs()
    bundle_path = args.file
    if not os.path.isfile(bundle_path):
        print(f"{C_RED}Error:{C_RESET} Archivo no encontrado: {bundle_path}")
        sys.exit(1)

    try:
        with open(bundle_path, "r", encoding="utf-8") as f:
            bundle = json.load(f)
    except Exception as e:
        print(f"{C_RED}Error:{C_RESET} Archivo JSON inválido: {e}")
        sys.exit(1)

    if not isinstance(bundle, dict) or bundle.get("format") != "codexc-bundle-v1":
        print(f"{C_RED}Error:{C_RESET} Formato de bundle no soportado (se esperaba 'codexc-bundle-v1').")
        sys.exit(1)

    accounts = bundle.get("accounts")
    if not isinstance(accounts, list) or not accounts:
        print(f"{C_RED}Error:{C_RESET} El bundle no contiene cuentas para importar.")
        sys.exit(1)

    rename_alias = getattr(args, "alias", None)
    if rename_alias and len(accounts) != 1:
        print(f"{C_RED}Error:{C_RESET} '--alias' solo puede usarse al importar un bundle de exactamente 1 cuenta.")
        sys.exit(1)

    overwrite = bool(getattr(args, "overwrite", False))
    existing_aliases = list_aliases()
    had_profiles_before = bool(existing_aliases)

    imported_aliases = []
    for entry in accounts:
        if not isinstance(entry, dict):
            print(f"{C_RED}Error:{C_RESET} Entrada de cuenta inválida en el bundle.")
            sys.exit(1)

        raw_alias = rename_alias or entry.get("alias")
        try:
            target_alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)

        auth_data = entry.get("auth")
        if not isinstance(auth_data, dict) or not auth_data:
            print(f"{C_RED}Error:{C_RESET} Datos 'auth' inválidos para '{target_alias}'.")
            sys.exit(1)

        auth_dst = get_profile_auth_file(target_alias)
        if (target_alias in existing_aliases or os.path.isfile(auth_dst)) and not overwrite:
            print(f"{C_RED}Error:{C_RESET} El perfil '{target_alias}' ya existe. Usa --overwrite para reemplazarlo.")
            sys.exit(1)

        new_acc_id, new_email = _extract_auth_identity(auth_data)
        if not overwrite:
            for other in existing_aliases:
                if other == target_alias:
                    continue
                other_acc_id, other_email = _get_existing_profile_identity(other)
                if (new_acc_id and other_acc_id and new_acc_id == other_acc_id) or (
                    new_email and other_email and new_email.lower() == other_email.lower()
                ):
                    print(
                        f"{C_RED}Error:{C_RESET} La cuenta ya existe en el perfil '{other}'. "
                        f"Usa --overwrite si deseas actualizarla."
                    )
                    sys.exit(1)

        prof_dir = get_profile_dir(target_alias)
        ensure_private_dir(prof_dir)

        with open(auth_dst, "w", encoding="utf-8") as f:
            json.dump(auth_data, f, indent=2)
        set_private_file_permissions(auth_dst)

        cfg_toml = entry.get("config_toml")
        if isinstance(cfg_toml, str):
            cfg_dst = os.path.join(prof_dir, "config.toml")
            if overwrite or not os.path.exists(cfg_dst):
                with open(cfg_dst, "w", encoding="utf-8") as f:
                    f.write(cfg_toml)
                set_private_file_permissions(cfg_dst)

        skills_src = os.path.join(SYSTEM_CODEX_DIR, "skills")
        skills_dst = os.path.join(prof_dir, "skills")
        if os.path.isdir(skills_src) and not os.path.exists(skills_dst):
            create_dir_link(skills_src, skills_dst)

        if target_alias not in existing_aliases:
            existing_aliases.append(target_alias)
        imported_aliases.append(target_alias)

    sync_launchers()
    if not had_profiles_before and imported_aliases:
        set_active_alias(imported_aliases[0])
        set_default_alias(imported_aliases[0])

    print(f"\n{C_BOLD}{C_GREEN}✓ Importación completada:{C_RESET} {', '.join(imported_aliases)}\n")

def main():
    parser = argparse.ArgumentParser(
        description="codexc - Administrador multi-cuenta y aislador de perfiles para OpenAI Codex CLI.",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Comandos disponibles")

    # list
    p_list = subparsers.add_parser("list", help="Listar cuentas, cuotas y estados")
    p_list.add_argument("--json", action="store_true", help="Salida en formato JSON")
    p_list.add_argument("--refresh", "-r", action="store_true", help="Forzar consulta en vivo a OpenAI")
    p_list.set_defaults(func=cmd_list)

    # switch
    p_switch = subparsers.add_parser("switch", help="Cambiar cuenta activa")
    p_switch.add_argument("alias", help="Alias de la cuenta (ej. codex01, codex02)")
    p_switch.set_defaults(func=cmd_switch)

    # default
    p_default = subparsers.add_parser("default", help="Establecer cuenta predeterminada")
    p_default.add_argument("alias", help="Alias de la cuenta")
    p_default.set_defaults(func=cmd_default)

    # add
    p_add = subparsers.add_parser("add", help="Vincular una nueva cuenta de Codex")
    p_add.add_argument("alias", nargs="?", help="Alias opcional (ej. codex02)")
    p_add.add_argument("--device-auth", action="store_true", help="Usar flujo de login por código de dispositivo")
    p_add.set_defaults(func=cmd_add)

    # quota
    p_quota = subparsers.add_parser("quota", help="Ver detalle de cuota de una cuenta")
    p_quota.add_argument("alias", nargs="?", help="Alias de la cuenta")
    p_quota.set_defaults(func=cmd_quota)

    # auto
    p_auto = subparsers.add_parser("auto", help="Rotar a la cuenta con mayor saldo disponible")
    p_auto.set_defaults(func=cmd_auto)

    # doctor
    p_doctor = subparsers.add_parser("doctor", help="Diagnosticar estado de perfiles y binarios")
    p_doctor.set_defaults(func=cmd_doctor)

    # rm
    p_rm = subparsers.add_parser("rm", help="Eliminar un perfil de cuenta")
    p_rm.add_argument("alias", help="Alias a eliminar")
    p_rm.set_defaults(func=cmd_rm)

    # export
    p_export = subparsers.add_parser("export", help="Exportar perfiles a un bundle JSON portable")
    p_export.add_argument("alias", nargs="?", help="Alias opcional a exportar (por defecto todos)")
    p_export.add_argument("-o", "--output", help="Ruta del archivo JSON de salida")
    p_export.set_defaults(func=cmd_export)

    # import
    p_import = subparsers.add_parser("import", help="Importar perfiles desde un bundle JSON portable")
    p_import.add_argument("file", help="Ruta del bundle JSON a importar")
    p_import.add_argument("--alias", help="Renombrar el alias importado (solo bundles de 1 cuenta)")
    p_import.add_argument("--overwrite", action="store_true", help="Sobreescribir perfil existente")
    p_import.set_defaults(func=cmd_import)

    # Atajo directo: si el primer argumento es un alias existente, actuar como 'switch'
    if len(sys.argv) == 2 and not sys.argv[1].startswith("-"):
        candidate = sys.argv[1]
        aliases = list_aliases()
        if candidate in aliases:
            set_active_alias(candidate)
            usage = fetch_codex_usage(candidate)
            print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta activa cambiada a: {candidate} ({usage.get('email', '')}){C_RESET}\n")
            sys.exit(0)

    if len(sys.argv) == 1:
        cmd_list(argparse.Namespace(refresh=False, json=False))
        sys.exit(0)

    args = parser.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        cmd_list(argparse.Namespace(refresh=False, json=False))

if __name__ == "__main__":
    main()
